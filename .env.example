# ─── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=es

# ─── Database (Neon Postgres) ───────────────────────────────────────────
# Get from https://console.neon.tech — project → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Auth.js v5 ─────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated list of admin emails allowed to sign in
ADMIN_EMAILS=andres@elementsmethod.com,anamichelle@elementsmethod.com
AUTH_EMAIL_FROM=hola@elementsmethod.com

# ─── Resend (transactional email) ───────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_TRANSACTIONAL=hola@elementsmethod.com

# ─── Transactional sender / ops inbox ───────────────────────────────────
# Where every "[Inscripción] / [Pago] / [Transferencia]" notice is delivered.
OPS_EMAIL=hello@elementsmethod.com

# ─── MailChimp (marketing) ──────────────────────────────────────────────
# API key format: <key>-<datacenter>, e.g. abc123-us21. The datacenter is read
# from the key itself; MAILCHIMP_SERVER_PREFIX is only a fallback.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_LIST_ID=
# Shared secret for the list webhook. Configure the callback in Mailchimp as
#   https://<domain>/api/mailchimp/webhook?secret=<this value>
# Without it the endpoint stays inert and unsubscribes never sync back.
MAILCHIMP_WEBHOOK_SECRET=

# ─── Stripe ─────────────────────────────────────────────────────────────
# Empty secret key ⇒ dry-run checkout (no charge, synthetic session id).
# Prefer a RESTRICTED key (rk_…) scoped to what the app needs over a full sk_.
# API version is pinned in src/shared/integrations/stripe.ts.
#
# Webhook endpoint: https://<domain>/api/stripe/webhook
# Events REQUIRED (all four — the async ones are what make delayed payment
# methods like OXXO safe; without them you either give away product that was
# never paid for, or never fulfil a payment that did clear):
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
# With STRIPE_WEBHOOK_SECRET set, the webhook REQUIRES a valid signature.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Stripe Tax ─────────────────────────────────────────────────────────
# Leave unset to keep the local IVA maths (16% inclusive, IVA_RATE below).
# Set to "true" ONLY after `pnpm stripe:preflight` reports tax settings
# active AND at least one active registration — otherwise Stripe accepts
# automatic_tax, returns no error, and collects zero tax. The app double
# checks at runtime and falls back to local maths if it would collect nothing.
STRIPE_TAX_ENABLED=

# ─── Form tokens (JWT) ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32
FORM_SIGNING_SECRET=

# ─── ManyChat ───────────────────────────────────────────────────────────
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=
NEXT_PUBLIC_MANYCHAT_WIDGET_ID=

# ─── Cal.com ────────────────────────────────────────────────────────────
CAL_API_KEY=
CAL_WEBHOOK_SECRET=
# Slugs de los event types publicados en Cal (deben existir o el embed da 404).
# Hoy la cuenta publica: 15min, 30min, empresas.
NEXT_PUBLIC_CAL_EVENT_INDIVIDUAL=30min
NEXT_PUBLIC_CAL_EVENT_ENTERPRISE=empresas
NEXT_PUBLIC_CAL_USERNAME=elementsmethod

# ─── AWS S3 (transfer-proof uploads) ────────────────────────────────────
# Bucket may stay fully private: uploads use a presigned PUT and the admin
# reads through /api/transferencias/comprobante, which mints a presigned GET.
# Without credentials the upload degrades to "send it by email" — it never
# fabricates a URL.
S3_BUCKET=elements-method-images
S3_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Bank transfer data (shown to buyers) ───────────────────────────────
BANK_NAME=
BANK_CLABE=
BANK_BENEFICIARY=
BANK_ACCOUNT_NUMBER=

# ─── Checkout payment methods ───────────────────────────────────────────
# Card is HIDDEN until CHECKOUT_CARD_ENABLED=true (Stripe still in setup; test
# keys must never face a real buyer). Set it to "true" locally to test card
# checkout against the Stripe sandbox (sk_test_). Deposit is shown unless
# CHECKOUT_TRANSFER_ENABLED=false. /api/checkout rejects hidden methods.
# With BANK_* empty, deposit buyers are told the details will arrive by email
# and ops receives a "[Depósito solicitado]" notice to send them by hand.
CHECKOUT_CARD_ENABLED=
CHECKOUT_TRANSFER_ENABLED=

# ─── Legal documents (contrato / NDA / relevo tokens) ───────────────────
# Identify the provider in the contracts. Blank RFC / address / representative
# render as ‹TOKEN› in the PDF on purpose — fill them before go-live.
LEGAL_ORG_NAME=                 # razón social; blank → "Elements Method"
LEGAL_ORG_RFC=
LEGAL_ORG_ADDRESS=
LEGAL_ORG_REP=                  # representante legal
LEGAL_ORG_EMAIL=                # blank → OPS_EMAIL
LEGAL_JURISDICTION=             # blank → "los Estados Unidos Mexicanos"
LEGAL_CITY=                     # blank → "Ciudad de México"
# Cancellation policy written into the contract (days before start → % refund)
LEGAL_CANCEL_FULL_DAYS=30
LEGAL_CANCEL_FULL_PCT=90
LEGAL_CANCEL_PARTIAL_DAYS=15
LEGAL_CANCEL_PARTIAL_PCT=50
LEGAL_NDA_YEARS=5

# ─── Tracking pixels (loaded only after consent) ────────────────────────
# These are FALLBACKS. Preferred: register the IDs in /admin/analytics (stored
# in the site_settings table, editable at runtime without a redeploy). A value
# set here is used only when the matching field in /admin/analytics is empty.
# Analítica propia (tabla page_views). Sal para el hash diario de visitante;
# si se deja vacía se usa AUTH_SECRET. Cambiarla reinicia el conteo de únicos del día.
ANALYTICS_SALT=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=

# ─── Fiscal / configuration ─────────────────────────────────────────────
# IVA México 16%
IVA_RATE=0.16

# ───────────────────────────────────────────────────────────────────────────
# SEO / indexación (ver docs/SEO_INDEXACION.md)
# ───────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL (arriba) es también el origen canónico: en producción
# DEBE ser https://elementsmethod.com — alimenta canonical, hreflang, sitemap,
# robots.txt y Open Graph.
#
# Código de verificación de Google Search Console (método "Etiqueta HTML":
# solo el valor de content="…", no la etiqueta completa). Opcional si se
# verifica por DNS.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (msvalidate.01). Opcional: Bing puede importar desde GSC.
BING_SITE_VERIFICATION=
